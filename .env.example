# PostgreSQL is the production database. Copy this file to .env and update values.
DATABASE_URL=postgresql+psycopg://username:password@host:5432/database_name
APP_NAME=Internship and Student Management API
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
